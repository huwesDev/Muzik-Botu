# Discord Bot Ayarları
TOKEN=           # Discord bot tokeni (Developer Portal → Bot → Token)
CLIENT_ID=       # Discord uygulama ID'si (Developer Portal → General Information)
GUILD_ID=        # (İsteğe bağlı) sunucu ID — boş bırakılırsa global kayıt yapılır

# Spotify API Anahtarları (spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Müzik Ayarları
DEFAULT_VOLUME=50                  # Başlangıç ses seviyesi (1-200)
LEAVE_ON_EMPTY_COOLDOWN=30000      # Kanal boşaldığında ayrılma süresi (ms)
LEAVE_ON_FINISH_COOLDOWN=30000     # Kuyruk bitince ayrılma süresi (ms)
